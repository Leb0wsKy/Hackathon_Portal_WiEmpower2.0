# Frontend environment for LAN access
# This binds the CRA dev server to all interfaces and points API calls to your backend IP
REACT_APP_API_BASE=http://192.168.80.40:4000
HOST=0.0.0.0
PORT=3000

# Notes:
# - Restart the dev server after creating/modifying this file.
# - For production builds, set REACT_APP_API_BASE before running `npm run build` so the
#   API base is baked into the static bundle.
