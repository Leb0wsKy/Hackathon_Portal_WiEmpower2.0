# Example environment variables for local LAN usage
# Replace 192.168.x.y with your machine's LAN IP
REACT_APP_API_BASE=http://172.20.10.3:4000
HOST=0.0.0.0
# Optional: change the frontend port
PORT=3000

# Notes:
# - For CRA dev server, you can create a file named .env (copy this) in the frontend/ folder
#   and then run `npm start`. Alternatively set env vars from PowerShell before starting.
# - REACT_APP_API_BASE must be set at build time for production builds (npm run build).
# - HOST=0.0.0.0 makes the dev server bind to all interfaces so other machines on the LAN
#   can access the frontend via http://<your-ip>:<PORT>.
